# Define the default config file path
# config ?= data_configs/CAMI_Airways.tsv
# TODO: remove this
config ?= data_configs/example.tsv

benchmark_dryrun: 
	snakemake -n -p --keep-going --snakefile snakefile.smk -c 100 --nolock --rerun-triggers mtime --keep-going --software-deployment-method apptainer --use-conda --rerun-incomplete --config bam_contig=$(config) --keep-incomplete all
benchmark_run:
	snakemake -p --keep-going --snakefile snakefile.smk -c 100 --nolock --rerun-triggers mtime --keep-going --software-deployment-method apptainer --use-conda --rerun-incomplete --config bam_contig=$(config) --keep-incomplete  all
benchmark_run_slurm:
	snakemake -p --keep-going  --snakefile snakefile.smk --nolock --rerun-triggers mtime --keep-going --software-deployment-method apptainer --use-conda --rerun-incomplete --keep-incomplete --latency-wait 60 --config bam_contig=$(config) --jobs 2 --max-jobs-per-second 2 --max-status-checks-per-second 35 --executor cluster-generic --cluster-generic-submit-cmd "sbatch --job-name {rule}  --time={resources.walltime} --cpus-per-task {threads} --mem {resources.mem_gb}G {resources.gpu}"  all
map_dryrun:
